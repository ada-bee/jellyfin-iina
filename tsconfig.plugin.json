{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "lib": ["ES2019"],
    "types": ["iina-plugin-definition"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/entries/player.ts",
    "src/entries/global.ts",
    "src/shared/**/*.ts",
    "src/playback/**/*.ts",
    "src/jellyfin/**/*.ts",
    "src/adapters/iina/**/*.ts",
    "src/overlay/eligibility.ts",
    "src/sidebar/launch.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}

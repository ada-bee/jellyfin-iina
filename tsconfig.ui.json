{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "types": ["iina-plugin-definition"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/entries/sidebar.ts",
    "src/entries/overlay.ts",
    "src/entries/preview.ts",
    "src/sidebar/**/*.ts",
    "src/overlay/**/*.ts",
    "src/preview/**/*.ts",
    "src/shared/**/*.ts",
    "src/playback/**/*.ts",
    "src/jellyfin/**/*.ts",
    "src/adapters/browser/**/*.ts",
    "src/sidebar/iina-webview.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
